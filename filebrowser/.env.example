# Copy to .env and adjust. .env is git-ignored; this file is not.

# ─── Required ───────────────────────────────────────────────────────
# The directory to browse. Mounted at /srv inside the container, which is
# what init/config.yaml points at.
#
# Add `:ro` to the volume line in compose.yaml if you want a viewer rather
# than a file manager -- worth considering, since anyone who logs in can
# delete whatever they can see.
BROWSE_PATH=/srv/downloads

# ─── Paths ──────────────────────────────────────────────────────────
# SQLite database: users, shares, search index. Back this up. Small.
#DATA_PATH=./data

# ─── Identity ───────────────────────────────────────────────────────
# The image runs as its own non-root user, uid/gid 1000, and reads no
# PUID/PGID -- these feed Docker's `user:` directive instead. They must be
# able to read BROWSE_PATH and write DATA_PATH.
#PUID=1000
#PGID=1000
#TZ=Europe/Paris

# ─── Ports ──────────────────────────────────────────────────────────
#PORT=3672

# Copy to .env and adjust. .env is git-ignored; this file is not.

# ─── Required ───────────────────────────────────────────────────────
# Password for the account named in init/copyparty.conf. That config grants
# access to this account ONLY -- there is no anonymous access.
#
#   openssl rand -base64 18
#
CP_PASSWORD=

# The directory to share. Bound to /w inside the container, which is what
# init/copyparty.conf serves at the webroot.
# Add `:ro` to the volume line in compose.yaml for a download-only server.
SHARE_PATH=/srv/downloads

# ─── Optional ───────────────────────────────────────────────────────
# Username. Change it here AND in the `accs:` block of init/copyparty.conf --
# the two must match or the account has no permissions.
#CP_USER=admin

# Index, thumbnails and copyparty's own config dir. Keeps state out of the
# shared folder. Back this up.
#DATA_PATH=./data

# The image runs as root unless told otherwise and reads no PUID/PGID; these
# feed Docker's `user:` directive. Must be able to read/write SHARE_PATH.
#PUID=1000
#PGID=1000
#TZ=Europe/Paris

#PORT=3923

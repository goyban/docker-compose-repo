# Copy to .env and adjust. .env is git-ignored; this file is not.

# ─── Required ───────────────────────────────────────────────────────
# Signs project invite tokens. Generate your own -- do not reuse anyone's:
#
#   openssl rand -base64 32
#
OVERLEAF_INVITE_TOKEN_SECRET=

# ─── Public address ─────────────────────────────────────────────────
# Every generated link is built from this: account activation, password
# reset, project invites. Overleaf defaults to http://localhost, so links
# come out wrong the moment you use a port or a domain -- and you only find
# out when someone can't reset their password.
#
#   local, non-standard port   http://192.168.1.50:8020
#   behind a reverse proxy     https://overleaf.example.com
#
OVERLEAF_SITE_URL=http://localhost:8020

# ─── Basics ─────────────────────────────────────────────────────────
#OVERLEAF_APP_NAME=Overleaf
#PORT=8020

# Where Mongo, Redis and Overleaf keep their data. Projects live here --
# this is the directory to back up.
#DATA_PATH=./data

# ─── HTTPS ──────────────────────────────────────────────────────────
# Serving over TLS? Uncomment OVERLEAF_SECURE_COOKIE in compose.yaml.
# Careful: the code checks `!= null`, so setting it to "false" turns it ON.
# The only way to disable it is to leave it unset.
